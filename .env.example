# Postgres (Neon). Use a dev branch locally: `neon env pull --branch dev` fills these two.
# DATABASE_URL is the pooled endpoint (app); DATABASE_URL_UNPOOLED is the direct endpoint (Alembic migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini (google-genai). Probe what your key can use: python scripts/probe_gemini.py
GEMINI_API_KEY=
CHEAP_MODEL=gemini-3.5-flash
STRONG_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-2
# Optional per-tier fallback pools (comma separated), used when a model hits its daily free-tier quota
# CHEAP_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash
# STRONG_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash
MAX_COST_PER_REPORT_USD=0.05

# Optional: web search for an incoming executive's professional background
TAVILY_API_KEY=

# Web Push (python scripts/gen_vapid.py >> .env)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

APP_TZ=Asia/Kolkata
